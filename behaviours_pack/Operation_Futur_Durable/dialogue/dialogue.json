            "commands": []
          },
          {
            "name": "2025",
            "commands": [
              "/tp @initiator ~-1000 ~ ~1000"
            ]
          }
        ]
      },

      {
        "scene_tag": "s_4_2_1",
        "npc_name": "EKO",
